# Files that the Okteto CLI sends to Remote Execution.

# "okteto deploy" and "okteto destroy" only need the Kubernetes manifest
[deploy]
*
!k8s.yml

[destroy]
*
!k8s.yml

# "okteto test" only needs what "dotnet test" reads
[test]
*
!**/*.csproj
!**/*.cs
!global.json
!appsettings*.json
!wwwroot
**/bin/**
**/obj/**
